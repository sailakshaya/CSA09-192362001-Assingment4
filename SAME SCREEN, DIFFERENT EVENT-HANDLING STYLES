(a) Frame implements ActionListener
import java.awt.*;
import java.awt.event.*;
 
public class ConverterFrameListener extends Frame implements ActionListener {
    TextField amount = new TextField(10);
    Choice target = new Choice();
    Label result = new Label(" ");
    Button convert = new Button("Convert");
 
    public ConverterFrameListener() {
        super("Currency Converter");
        setLayout(new FlowLayout());
        target.add("USD"); target.add("EUR");
        add(new Label("INR")); add(amount); add(target); add(convert); add(result);
        convert.addActionListener(this);
        amount.addActionListener(this);
        addWindowListener(new WindowAdapter() {
            @Override public void windowClosing(WindowEvent e) { dispose(); }
        });
        setSize(350, 140);
    }
 
    public void actionPerformed(ActionEvent e) {
        try {
            double value = Double.parseDouble(amount.getText().trim());
            double rate = target.getSelectedItem().equals("USD") ? 0.012 : 0.011;
            result.setText(String.format("%.2f", value * rate));
            if (e.getSource() == amount)
                java.awt.Toolkit.getDefaultToolkit().beep();
        } catch (NumberFormatException ex) {
            result.setText("Invalid amount");
        }
    }
 
    public static void main(String[] args) {
        EventQueue.invokeLater(() -> {
            ConverterFrameListener f = new ConverterFrameListener();
            f.setVisible(true);
        });
    }
}

